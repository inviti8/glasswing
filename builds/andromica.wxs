<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Andromica"
           Manufacturer="HEAVYMETA Cooperative"
           Version="$(var.Version)"
           UpgradeCode="B3D7F4A1-8E2C-4F6B-9A1D-5C3E7F8B2D4A"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Andromica is already installed."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AndromicaIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AndromicaIcon" />
    <Property Id="ARPHELPLINK" Value="https://heavymeta.art" />
    <Property Id="ARPURLINFOABOUT" Value="https://heavymeta.art" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLDIR" Name="Andromica">
          <Component Id="AndromicaShortcuts" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
            <RegistryValue Root="HKCU"
                           Key="Software\HEAVYMETA\Andromica"
                           Name="Installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
            <Shortcut Id="DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="Andromica"
                      Description="Creative media application"
                      Target="[INSTALLDIR]andromica.exe"
                      Icon="AndromicaIcon"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Andromica"
                      Description="Creative media application"
                      Target="[INSTALLDIR]andromica.exe"
                      Icon="AndromicaIcon"
                      WorkingDirectory="INSTALLDIR" />
            <RemoveFolder Id="RemoveStartMenuShortcut"
                          Directory="ProgramMenuFolder"
                          On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Harvest all files from the PyInstaller dist directory -->
    <ComponentGroup Id="AndromicaFiles" Directory="INSTALLDIR">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <Feature Id="Complete" Title="Andromica" Level="1">
      <ComponentGroupRef Id="AndromicaFiles" />
      <ComponentRef Id="AndromicaShortcuts" />
    </Feature>
  </Package>
</Wix>
